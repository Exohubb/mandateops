# Copy this file to .env and fill in your real values. Never commit .env.

# Google Gemini API key (free tier). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use for the low-latency, high-volume jobs
# (decline-reason normalization, message drafting)
GEMINI_MODEL_FAST=gemini-2.5-flash-lite

# Which Gemini model to use for the higher-reasoning, low-volume jobs
# (AI Copilot chat, executive summary)
GEMINI_MODEL_REASONING=gemini-2.5-flash

# Backend server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# SQLite database file path (relative to backend/)
DATABASE_PATH=./data/mandateops.db

# CORS origin(s) allowed to call the API, comma separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
